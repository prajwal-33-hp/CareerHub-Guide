NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or a local mongodb://localhost:27017/careerhub)
MONGO_URI=

# Use a long, random string in production -- e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Must match the frontend's dev server so CORS allows requests through
CLIENT_URL=http://localhost:5173

# Google Gemini AI API Key (get it from https://aistudio.google.com/app/apikeys)
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Real Email Delivery (SMTP / Gmail App Password / SendGrid / Custom SMTP)
# For Gmail: Use your Gmail address and generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="CareerHub Verifications" <your-email@gmail.com>

# Optional Custom SMTP settings (if not using Gmail):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false


