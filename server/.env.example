NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or a local mongodb://localhost:27017/careerhub)
MONGO_URI=

# Use a long, random string in production -- e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Must match the frontend's dev server so CORS allows requests through
CLIENT_URL=http://localhost:5173

# Google Gemini AI API Key (get it from https://aistudio.google.com/app/apikeys)
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Real Email Delivery (Dual Provider: Brevo for Instant Delivery + Gmail App Password Fallback)
# 1. Primary: Brevo (Ultra-fast instant sub-second delivery - Free 300 emails/day at https://www.brevo.com)
BREVO_SMTP_USER=your-brevo-account-email@gmail.com
BREVO_SMTP_KEY=xsmtpsib-your-brevo-smtp-key-here

# 2. Fallback: Gmail App Password (16-char App Password at https://myaccount.google.com/apppasswords)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASS=your-16-char-app-password

# Email sender display name & address
EMAIL_FROM="CareerHub Verifications" <your-email@gmail.com>


